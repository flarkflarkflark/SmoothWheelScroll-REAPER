// settings_panel_linux.rc -- the Linux/macOS settings window (Phase 2b).
//
// SWELL has no CreateWindowEx/RegisterClass (see PORTING.md's settings-ui-port scoping report), so
// the window itself is a dialog resource, the same mechanism REAPER and SWS use. This file is parsed
// by swell_resgen.pl at build time (see build-linux.sh) into settings_panel_linux.rc_mac_dlg.
//
// The dialog has NO child controls. The panel is painted and mouse-driven by smooth_wheel_scroll.cpp
// (PaintLinuxPanel / CfgProcLinux), at the geometry in LinuxGeomOf. The Windows build never sees this
// file: its window is built programmatically, untouched by this change.
#include "settings_panel_linux_resource.h"

IDD_SWS_SETTINGS_LINUX DIALOG DISCARDABLE 0, 0, 360, 352
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Smooth Wheel Scroll"
FONT 8, "MS Shell Dlg"
BEGIN
END
